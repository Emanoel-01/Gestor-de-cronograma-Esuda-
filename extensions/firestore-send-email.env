# Configuração da extensão Trigger Email from Firestore (firebase/firestore-send-email)
# Coleção monitorada para disparo automático de mensagens:
MAIL_COLLECTION=mail

# Remetente padrão das comunicações institucionais
DEFAULT_FROM=posgraduacao@esuda.edu.br
DEFAULT_REPLY_TO=emanoel@esuda.edu.br

# Servidor SMTP (configurado no ambiente do Firebase Console / GCP)
# Exemplo: smtps://usuario:senha@smtp.gmail.com:465
SMTP_CONNECTION_URI=

# Coleções opcionais
USERS_COLLECTION=
TEMPLATES_COLLECTION=
